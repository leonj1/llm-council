# OpenRouter API Key
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Tailscale Configuration (for Docker container network access)
# Generate an auth key at: https://login.tailscale.com/admin/settings/keys
# Recommended: Create a reusable, ephemeral key with appropriate tags
TS_AUTHKEY=tskey-auth-xxxxx

# Optional: Custom hostname for this container on your tailnet
# If not set, Tailscale will auto-generate a name
TS_HOSTNAME=llm-council

# Optional: Enable Tailscale Serve to expose port 8001 via HTTPS on your tailnet
# Set to "true" to enable
TS_SERVE=false
