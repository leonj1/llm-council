# OpenRouter API Key
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# MySQL Database Configuration
# Required for user persistence. Flyway migrations run on container start.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=llm_council

# Tailscale Configuration (for Docker container network access)
# Generate an auth key at: https://login.tailscale.com/admin/settings/keys
# Recommended: Create a reusable, ephemeral key with appropriate tags
TS_AUTHKEY=tskey-auth-xxxxx

# Optional: Custom hostname for this container on your tailnet
# If not set, Tailscale will auto-generate a name
TS_HOSTNAME=llm-council

# Optional: Enable Tailscale Serve to expose port 8001 via HTTPS on your tailnet
# Set to "true" to enable
TS_SERVE=false

# Agent Memory API Configuration (for Memory Explorer)
# Used by admin users to search shared agent memories
AGENT_MEMORY_API_URL=https://api-production-0d67.up.railway.app
AGENT_MEMORY_API_TOKEN=your_agent_memory_api_token_here
